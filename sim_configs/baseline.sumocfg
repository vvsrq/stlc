<configuration>
    <input>
        <net-file value="intersection.net.xml"/>
        <route-files value="evaluation_routes.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="10000"/>
    </time>

    <report>
        <duration-log.disable value="true"/>
        <no-step-log value="true"/>
    </report>

</configuration>